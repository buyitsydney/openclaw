{
  "id": "realtime",
  "uiHints": {
    "enabled": {
      "label": "Enable Realtime",
      "help": "Enable Gemini Live + OpenClaw realtime voice integration"
    },
    "port": {
      "label": "WebSocket Port",
      "help": "Port for the Realtime WebSocket server (default: 18790)"
    },
    "gemini.projectId": {
      "label": "GCP Project ID",
      "help": "Google Cloud Project ID for Gemini Live API"
    },
    "gemini.model": {
      "label": "Gemini Model",
      "help": "Gemini Live model name (e.g. gemini-live-2.5-flash-native-audio)"
    },
    "gemini.location": {
      "label": "GCP Location",
      "help": "Google Cloud location (default: us-central1)"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "port": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "gemini": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectId": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        }
      }
    }
  }
}
