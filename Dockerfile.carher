# Car Her 容器化 Dockerfile
# 基于现有 Dockerfile，增加 Python（Live Frontend Proxy 需要）
#
# 构建: ./start-docker.sh
# 用法: cd deploy/carher-N && docker compose up -d
#
# 层缓存策略:
#   layers 1-5  — 系统包/工具链（极少变动）
#   layers 6-9  — 依赖清单 package.json/lockfile/patches（只改依赖才失效）
#   layer 10    — pnpm install（带 store 缓存挂载，即使失效也秒级）
#   layer 11-12 — pip install（独立于源码，requirements.txt 不变就不装）
#   layer 13+   — 源码 COPY + build（日常改代码只从这里开始 ~30s）

FROM node:22-bookworm

# Install Bun + Python3 + Chromium (browser tool) + CJK fonts
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv curl ffmpeg \
      chromium fonts-liberation fonts-noto-cjk fonts-noto-color-emoji && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

RUN corepack enable

WORKDIR /app

# --- Full source copy, then install + build ---
COPY . .
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --no-frozen-lockfile

RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install --break-system-packages -r extensions/realtime/live-frontend/requirements.txt requests

RUN cd docker/plugins/a2a-gateway && npm install --omit=dev --ignore-scripts 2>/dev/null || true
RUN cd docker/plugins/feishu-her  && npm install --omit=dev --ignore-scripts 2>/dev/null || true
RUN NODE_OPTIONS=--max-old-space-size=1536 OPENCLAW_A2UI_SKIP_MISSING=1 pnpm build:docker
ENV OPENCLAW_PREFER_PNPM=1
# npm install -g goes to persistent volume so Her's CLI installs survive restarts.
ENV NPM_CONFIG_PREFIX="/data/.openclaw/local"
ENV PATH="/data/.openclaw/local/bin:${PATH}"
RUN pnpm ui:build

# Entrypoint script
COPY scripts/carher-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV NODE_ENV=production

# Embed build hash for image version identification
# Format: "<git-sha>" or "<git-sha>-dirty-<diff-hash>"
ARG BUILD_HASH=unknown
LABEL carher.build.hash=$BUILD_HASH

# Ports: Gateway(18789), Realtime(18790), Frontend(8000), WS Proxy(8080)
EXPOSE 18789 18790 8000 8080

CMD ["/entrypoint.sh"]
