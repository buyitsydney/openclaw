# Car Her v2 — A+B 架构：openclaw 官方镜像作为 base，feishu-her/a2a-gateway 作为独立插件
#
# 升级 openclaw：只改 FROM 行一个 tag
# 升级 feishu-her：只重装 /app/docker/plugins/feishu-her (独立语义化版本)
# 升级 a2a-gateway：只重装 /app/docker/plugins/a2a-gateway (独立语义化版本)
#
# 三条轴独立，互不耦合。

ARG OPENCLAW_TAG=2026.4.24

# Her 可读的 upstream openclaw src（只读、不参与 runtime）
# 用 openclaw 官方 image 本身作 builder —— 它已经装了 git 2.39，省掉 docker.io 依赖
# （docker.io 在大陆常有 TLS 握手超时，ghcr.io 稳定可达）
# 3 层 fallback: v 前缀 → bare → 空目录（GitHub 挂了不阻塞 build）
FROM ghcr.io/openclaw/openclaw:${OPENCLAW_TAG} AS openclaw-src-fetcher
ARG OPENCLAW_TAG
USER root
RUN set -e; \
    (git clone --depth=1 --branch v${OPENCLAW_TAG} \
        https://github.com/openclaw/openclaw.git /src 2>/dev/null \
     || git clone --depth=1 --branch ${OPENCLAW_TAG} \
        https://github.com/openclaw/openclaw.git /src 2>/dev/null \
     || mkdir -p /src/src); \
    echo "openclaw-src-fetcher: $(ls /src/src 2>/dev/null | wc -l) entries in /src/src"

FROM ghcr.io/openclaw/openclaw:${OPENCLAW_TAG}
ARG OPENCLAW_TAG

# Base 镜像默认 USER=node，apt/pip/npm 操作需要 root
USER root

# CarHer 运行时依赖（官方镜像未包含）：
#   python3 + ffmpeg  → live-frontend 代理
#   chromium + 字体   → browser 工具 + 中文/emoji 渲染
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv ffmpeg \
      chromium fonts-liberation fonts-noto-cjk fonts-noto-color-emoji && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Live Frontend 是 CarHer 自带扩展（上游 openclaw 镜像不含），从我们的工作区拷贝
COPY extensions/realtime/live-frontend /app/extensions/realtime/live-frontend

# Live Frontend Python 依赖
RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install --break-system-packages \
      -r /app/extensions/realtime/live-frontend/requirements.txt requests

# shadow-daemon v8.8 PDF 分批拆页依赖
RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install --break-system-packages pymupdf

# 独立插件 —— 拷贝 + npm install --omit=dev（每个插件各自一层，缓存友好）
WORKDIR /app

# Three-component architecture: keep bundled feishu (id=feishu, channels=["feishu"])
# as the channel provider. feishu-her (id=feishu-her, channels=[]) is tool-only.
# The bundled feishu handles: CardKit v2 streaming, abort-detect, typing indicator,
# sequential queue, deliveredFinalTexts dedup, 12 basic tools.
# feishu-her handles: Discussion Mode, Bot Registry, knowledge_qa, group-mode.
#
# Legacy note: previously removed bundled feishu because feishu-her also registered
# channels: ["feishu"]. Now feishu-her has channels: [] so they coexist.

COPY docker/plugins/feishu-her  /app/docker/plugins/feishu-her
RUN --mount=type=cache,target=/root/.npm \
    cd /app/docker/plugins/feishu-her && \
    npm install --omit=dev --ignore-scripts

COPY docker/plugins/a2a-gateway /app/docker/plugins/a2a-gateway
RUN --mount=type=cache,target=/root/.npm \
    cd /app/docker/plugins/a2a-gateway && \
    npm install --omit=dev --ignore-scripts

COPY docker/plugins/shadow-daemon /app/docker/plugins/shadow-daemon
RUN --mount=type=cache,target=/root/.npm \
    cd /app/docker/plugins/shadow-daemon && \
    npm install --omit=dev --ignore-scripts

# Config is NOT baked into the image. All config comes from runtime bind mounts
# (config/base.json5, config/docker.json5, config/u{N}.json5) or env vars.
# The legacy shared-config.json5 and docker/user-configs/ used to be copied here
# but were decommissioned in Phase 2 of the compose migration — image is now
# truly immutable and reused across all users without per-user content.

# Her 可读的 upstream openclaw 源码（只读，不参与 runtime）
# runtime 走 /app/dist/；查源码走 /app/openclaw-src/src/
COPY --from=openclaw-src-fetcher /src/src /app/openclaw-src/src

# ---- her-self-inspect v2: bake frozen git-log + skills into image (k8s-friendly)
# image-info.json is generated on host by scripts/freeze-git-info.sh via
# deploy/build-and-push.sh (kept out of .dockerignore by living at build/).
COPY build/image-info.json /opt/carher/image-info.json
RUN chmod 444 /opt/carher/image-info.json


# NOTE: shared skills are NOT baked into the image.
# They live on hosts at ~cltx/.openclaw/skills/ (bind-mount :ro → /data/.openclaw/skills/)
# and are distributed via scripts/publish-shared-skills.sh (rsync). Single source of truth.
# ---- end her-self-inspect v2

# Entrypoint
# ---- reset-archive-session-memory patch set (feat/reset-archive-session-memory-20260502 @ 0e692c385d)
COPY scripts/apply-reset-archive-patches.sh /tmp/apply-reset-archive-patches.sh
RUN chmod +x /tmp/apply-reset-archive-patches.sh && /tmp/apply-reset-archive-patches.sh

# NOTE: dist-manifest MUST be frozen AFTER apply-reset-archive-patches,
#       otherwise manifest captures pre-patch baseline and sha256_drift=4 forever.
# Freeze /app/dist sha256 manifest for hot-patch drift detection at runtime.
# Any later mutation of /app/dist/*.js will be caught by her-self-inspect
# diff-ing against this baseline (bak scan + sha256 drift = full coverage).
RUN cd / && find /app/dist -type f -name '*.js' -print0 | xargs -0 sha256sum > /opt/carher/dist-manifest.txt && chmod 444 /opt/carher/dist-manifest.txt
# ---- end reset-archive-session-memory patch set
COPY scripts/carher-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# 全局 npm 安装去到持久卷(Her 的 CLI 安装跨重启保留)
ENV NPM_CONFIG_PREFIX="/data/.openclaw/local"
# pip install --user 默认 $HOME/.local = /data/.local (HOME=/data via start-user.sh)。
# /data 是 docker volume,所以 /data/.local 自动持久化。把 .local/bin 加进 PATH
# 让 markitdown 等 CLI 可调用。
ENV PATH="/data/.openclaw/local/bin:/data/.local/bin:${PATH}"
ENV NODE_ENV=production

# PIP_BREAK_SYSTEM_PACKAGES: 绕开 Debian 12+ 的 PEP 668 externally-managed 拦截。
# 我们故意不设 PYTHONUSERBASE — 让 pip --user 走默认 $HOME/.local,这样
# 不论 Her 在哪个 shell 上下文(docker exec / claude code subprocess /
# bash -l)安装,pip 都落到同一个固定位置 /data/.local。daemon 进程同样
# 不强制 PYTHONUSERBASE,继承相同默认 → 装包路径与读取路径绝对一致。
ENV PIP_BREAK_SYSTEM_PACKAGES=1

ARG BUILD_HASH=unknown
LABEL carher.build.hash=$BUILD_HASH
LABEL carher.openclaw.tag=$OPENCLAW_TAG
LABEL carher.build.dockerfile=Dockerfile.carher.v2

EXPOSE 18789 18790 8000 8080
CMD ["/entrypoint.sh"]
