# docker/server.env.example — template for per-server shared env vars
#
# Copy to docker/server.env (gitignored) and fill in real values.
# Loaded by start.sh and compose via `set -a; source docker/server.env; set +a`.
#
# This file is a public template. DO NOT put real secrets here.

# Anthropic (Wangsu LiteLLM proxy — carher deploys hit this, not api.anthropic.com)
ANTHROPIC_BASE_URL=https://litellm.example.internal
ANTHROPIC_AUTH_TOKEN=replace-me-wangsu-token

# OpenRouter (used as alternative provider on all environments)
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Voyage (memory search embeddings)
VOYAGE_API_KEY=replace-me-voyage

# Groq (occasional alt provider)
GROQ_API_KEY=replace-me-groq

# Redis (cross-container card/message cache; only needed where Redis is used)
REDIS_URL=redis://localhost:6379

# Gateway token (docker gateway auth.mode=token).
# Each container can share the same token within one deployment.
CARHER_GATEWAY_TOKEN=replace-me-gateway-token

# Gemini Live realtime (server-wide default; admin host can override per-user)
GEMINI_PROJECT_ID=
