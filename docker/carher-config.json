{
  "$include": "./shared-config.json5",
  "meta": {
    "lastTouchedVersion": "2026.2.1"
  },
  "agents": {
    "defaults": {
      "contextTokens": 200000,
      "model": {
        "primary": "openrouter/anthropic/claude-sonnet-4.6"
      }
    }
