// CarHer 共享功能配置 — 本地 Her 和所有 Docker 用户容器共用
// 修改此文件会同时影响所有环境（本地 + Docker），请谨慎
//
// 规则:
// - 只放所有环境通用的功能配置
// - 不放 secrets（API keys 用 ${VAR_NAME} 引用）
// - 数组类型可以放这里，但 overlay 不要重复同一个 key（否则 deep merge 会 concat）
// - 不放环境特有配置（gateway bind/auth、browser headless 等）

{
  // Agent 默认配置
  agents: {
    defaults: {
      userTimezone: "Asia/Shanghai",
      llm: { idleTimeoutSeconds: 300 },
      compaction: { mode: "safeguard", reserveTokens: 200000 },
      // 并发上限（10 群并行深度研究场景）
      maxConcurrent: 16,
      subagents: { maxConcurrent: 64 },
      // 语义搜索记忆 — apiKey 通过环境变量注入
      memorySearch: {
        provider: "openai",
        remote: {
          baseUrl: "https://openrouter.ai/api/v1/",
          apiKey: "${OPENROUTER_API_KEY}",
        },
        model: "BAAI/bge-m3",
        sources: ["memory", "sessions"],
        experimental: { sessionMemory: true },
        query: {
          minScore: 0.25,
          maxResults: 8,
          hybrid: {
            vectorWeight: 0.7,
            textWeight: 0.3,
            mmr: { enabled: true, lambda: 0.4 },
          },
        },
      },
    },
  },

  // 工具配置
  tools: {
    web: {
      search: { provider: "perplexity" },
    },
    // 显式指定 Groq STT，跳过本地 whisper auto-detect
    media: {
      audio: {
        models: [{ provider: "groq" }],
      },
    },
  },

  // 命令（环境特有的 restart 由各自 overlay 设置）
  commands: {
    native: "auto",
    nativeSkills: "auto",
  },

  // 消息格式
  messages: {
    ackReactionScope: "group-mentions",
    tts: {
      auto: "inbound",
      provider: "edge",
      providers: {
        edge: { voice: "zh-CN-XiaoxiaoNeural" },
      },
    },
  },

  // 浏览器（headless/noSandbox 由各自 overlay 覆盖）
  browser: {
    enabled: true,
    defaultProfile: "openclaw",
    cdpPortRangeStart: 18900, // avoid conflict with a2a-gateway on 18800
  },

  // 插件
  plugins: {
    // feishu-her 占用 channel.id=feishu；禁用 bundled 的 feishu 防冲突。
    deny: ["feishu"],
    // 相对 cwd 解析：docker 启动 cwd=/app，host 启动 cwd=<worktree>，两边都能命中。
    load: {
      paths: [
        "docker/plugins/feishu-her",
        "docker/plugins/a2a-gateway",
      ],
    },
    entries: {
      "feishu-her": { enabled: true },
      "a2a-gateway": {
        enabled: true,
        config: {
          routing: { defaultAgentId: "main" },
          limits: { maxConcurrentTasks: 16 },
        },
      },
      "memory-core": {
        config: {
          dreaming: {
            enabled: false,
            timezone: "Asia/Shanghai",
            frequency: "0 3 * * *",
          },
        },
      },
      "active-memory": {
        enabled: false,
      },
      "memory-wiki": {
        enabled: true,
        config: {
          vaultMode: "bridge",
          bridge: {
            enabled: true,
            readMemoryArtifacts: true,
            indexDreamReports: true,
            indexDailyNotes: true,
            indexMemoryRoot: true,
            followMemoryEvents: true,
          },
          ingest: {
            autoCompile: true,
            allowUrlIngest: true,
          },
          search: {
            backend: "shared",
            corpus: "all",
          },
        },
      },
    },
  },

  // 飞书基础配置（凭证由各环境 overlay 提供）
  channels: {
    feishu: {
      enabled: true,
      groupPolicy: "open",
    },
  },
}
