# docker/users/{USER_ID}.env.example — template for per-user secrets
#
# Copy to docker/users/{USER_ID}.env (gitignored) and fill in real values.
# Loaded by compose as `--env-file docker/users/${USER_ID}.env` on
# `docker run`, so these vars are ONLY visible inside that one container.
#
# These vars are referenced by ${FEISHU_APP_SECRET_${USER_ID}} etc. in
# config/users/${USER_ID}.json5 and resolved at openclaw config load time
# by src/config/env-substitution.ts.
#
# File permissions: chmod 600 recommended.
# This .example is the public template — DO NOT put real secrets here.

# Feishu bot credentials (per-user identity — one pair per docker user)
# Look up the secret for this USER_ID in users.csv (column 5) or the
# Feishu developer console. appId is public metadata and lives in
# config/users/{USER_ID}.json5 directly.
FEISHU_APP_SECRET=replace-me-per-user-feishu-secret
