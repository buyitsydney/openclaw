# ~/.openclaw/.env.example — template for admin Mac Her secrets
#
# Copy to ~/.openclaw/.env (chmod 600) and fill in real values.
# Loaded before running ./start.sh via `set -a; source ~/.openclaw/.env; set +a`
# (or integrate with direnv / launchd EnvironmentFile).
#
# Referenced by ${VAR_NAME} substitutions in config/users/admin.json5 and
# resolved at openclaw config load by src/config/env-substitution.ts.
#
# ⚠️ DO NOT put real secrets in this .example file. It is the public template.

# Feishu — admin bot credentials (appSecret is the one secret in feishu)
FEISHU_APP_SECRET_ADMIN=replace-me-admin-feishu-secret

# Anthropic — direct key for the Mac (goes to Anthropic API or a Mac-local proxy)
# Docker uses ANTHROPIC_AUTH_TOKEN / ANTHROPIC_BASE_URL via docker/server.env instead.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Shanxia — Mac-only China proxy provider
SHANXIA_API_KEY=replace-me-shanxia

# OpenRouter — alternative provider
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Voyage — memory search embeddings
VOYAGE_API_KEY=replace-me-voyage

# Groq — occasional alt provider
GROQ_API_KEY=replace-me-groq

# Gateway token (host Mac: gateway.auth.mode=none is the norm, so this may
# be unused; still defined to allow opt-in)
CARHER_GATEWAY_TOKEN_HOST=my-local-token-12345
