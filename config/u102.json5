// config/u102.json5 — Docker carher-102 identity (Layer 3)
//
// Same structure as u101.json5 — only per-user feishu identity differs.
// Primary model + docker-shared behavior comes from docker.json5 → base.json5.

{
  "$include": "./docker.json5",

  // 2026-04-27 upstream workaround: explicit root-level gateway.mode to avoid
  // "gateway-mode-missing-vs-last-good" false-positive clobber in 0424 CLI
  // pre-check. See u13.json5 for the fleet-wide note.
  gateway: {
    mode: "local",
  },

  channels: {
    feishu: {
      name: "tester2的her",
      appId: "cli_a93cbff979b89bd8",
      appSecret: "${FEISHU_APP_SECRET}",
      botOpenId: "ou_d2dcb5a6c7ad3934861b7120c30c2b1e",
      oauthRedirectUri: "https://u102-auth.carher.net/feishu/oauth/callback",
      dm: {
        allowFrom: ["ou_7ec6c07f195f970e08eefc63f007dd93"],
      },
    },
  },
}
