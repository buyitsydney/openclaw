// config/u101.json5 — Docker carher-101 identity (Layer 3)
//
// $include's docker.json5 → base.json5. Mounted into the container at
// /data/.openclaw/config/u101.json5 and read via OPENCLAW_CONFIG_PATH.
//
// Only per-user feishu identity. Primary model + all other behavior
// comes from docker.json5 / base.json5. Real appSecret is injected via
// -e FEISHU_APP_SECRET on docker run (from users.csv).

{
  "$include": "./docker.json5",

  channels: {
    feishu: {
      name: "tester的her",
      appId: "cli_a92c99d102b8dbca",
      appSecret: "${FEISHU_APP_SECRET}",
      botOpenId: "ou_1a9c02079fef1f5f0f4daaaaffd2326c",
      oauthRedirectUri: "https://u101-auth.carher.net/feishu/oauth/callback",
      dm: {
        allowFrom: ["ou_a7afacbb81237891a181832ac7a76294"],
      },
    },
  },
}
