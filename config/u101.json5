// config/u101.json5 — Docker carher-101 identity (Layer 3)
//
// $include's docker.json5 → base.json5. Mounted into the container at
// /data/.openclaw/config/u101.json5 and read via OPENCLAW_CONFIG_PATH.
//
// Only per-user feishu identity. Primary model + all other behavior
// comes from docker.json5 / base.json5. Real appSecret is injected via
// -e FEISHU_APP_SECRET on docker run (from users.csv).

{
  "$include": "./docker.json5",

  // 2026-04-27: openclaw 2026.4.24 启动检查 root parsed gateway.mode 不展开
  // $include。每个 user config 都必须在顶层显式声明,否则会触发 clobber
  // ("Config auto-restored from backup: gateway-mode-missing-vs-last-good")。
  // 已知 upstream 限制,fleet-wide workaround(见 u13/14/75/198/199/200)。
  gateway: {
    mode: "local",
  },

  channels: {
    feishu: {
      // Only fields recognized by BOTH bundled feishu schema (additionalProperties:false)
      // AND openclaw-lark schema. "name" is NOT in bundled schema → moved to plugin config.
      appId: "cli_a92c99d102b8dbca",
      appSecret: "${FEISHU_APP_SECRET}",
      dmPolicy: "allowlist",
      allowFrom: ["ou_a7afacbb81237891a181832ac7a76294"],
    },
  },

  plugins: {
    entries: {
      // feishu-her-specific config: fields NOT in bundled feishu schema
      // (name, botOpenId, oauthRedirectUri) live here.
      "feishu-her": {
        config: {
          name: "tester的her",
          botOpenId: "ou_1a9c02079fef1f5f0f4daaaaffd2326c",
          oauthRedirectUri: "https://u101-auth.carher.net/feishu/oauth/callback",
        },
      },
    },
  },
}
