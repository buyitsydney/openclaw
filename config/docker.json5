// config/env/docker.json5 — Docker carher-{N} environment overlay
//
// $include's base.json5. Overrides/adds fields that differ for every docker
// container but are identical across docker users.
//
// Do NOT put per-user identity here (feishu appId, primary model, etc.) —
// those live in users/{N}.json5.
//
// All secrets are ${VAR_NAME}; real values come from docker/server.env
// (shared) or docker/users/{N}.env (per-user, injected via --env-file).

{
  "$include": "./base.json5",

  browser: {
    headless: true,
    noSandbox: true,
  },

  channels: {
    feishu: {
      // Docker users default to open group policy; admin host defaults to
      // allowlist in users/admin.json5.
      groupPolicy: "open",
    },
  },

  commands: {
    restart: false,
  },

  gateway: {
    bind: "lan",
    auth: {
      mode: "token",
      token: "${CARHER_GATEWAY_TOKEN}",
    },
    controlUi: {
      allowInsecureAuth: true,
      dangerouslyAllowHostHeaderOriginFallback: true,
      dangerouslyDisableDeviceAuth: true,
    },
  },

  agents: {
    defaults: {
      // All docker users default to Wangsu opus-4-7 as primary. Override
      // per-user in config/u${N}.json5 if needed (e.g., users with CSV
      // provider=openrouter may want openrouter/anthropic/claude-opus-4.7).
      model: { primary: "anthropic/anthropic.claude-opus-4-7" },
      models: {
        // Wangsu (anthropic-messages API) aliases.
        // Keys MUST match the model ids declared in
        // models.providers.anthropic.models below — Wangsu requires the
        // "anthropic." prefix; non-prefixed ids are rejected with 401
        // "key not allowed to access model". These cover the default
        // docker user (CSV provider=anthropic, which is 4/6 of the fleet).
        // Users with CSV provider=openrouter override these in their
        // config/u${N}.json5 to point "opus"/"sonnet" at openrouter/* ids.
        "anthropic/anthropic.claude-opus-4-7": { alias: "opus" },
        "anthropic/anthropic.claude-opus-4-6": { alias: "opus46" },
        "anthropic/anthropic.claude-sonnet-4-6": { alias: "sonnet" },
        "anthropic/anthropic.claude-haiku-4-5": { alias: "haiku" },

        // OpenRouter aliases (match the pre-rebuild docker aliases so users
        // don't have to relearn; host uses its own set in users/admin.json5).
        "openrouter/anthropic/claude-opus-4.7": {
          alias: "or-opus",
          params: { provider: { allow_fallbacks: true, ignore: ["Google"] } },
        },
        "openrouter/anthropic/claude-opus-4.6": {
          alias: "or-opus46",
          params: { provider: { allow_fallbacks: true, ignore: ["Google"] } },
        },
        "openrouter/anthropic/claude-sonnet-4.6": {
          alias: "or-sonnet",
          params: { provider: { allow_fallbacks: true, ignore: ["Google"] } },
        },
        "openrouter/google/gemini-3.1-pro-preview": { alias: "gemini" },
        "openrouter/minimax/minimax-m2.7": { alias: "minimax" },
        "openrouter/openai/gpt-5.5": { alias: "gpt" },
        "openrouter/openai/gpt-5.4": { alias: "gpt54" },
        "openrouter/openai/gpt-5.3-codex": { alias: "codex" },
        "openrouter/deepseek/deepseek-v4-pro": { alias: "ds" },
        "openrouter/deepseek/deepseek-v4-flash": { alias: "ds-flash" },
      },
    },
  },

  acp: {
    enabled: true,
    backend: "acpx",
    defaultAgent: "claude",
    allowedAgents: ["claude"],
    maxConcurrentSessions: 2,
    dispatch: { enabled: true },
    runtime: { ttlMinutes: 120 },
  },

  plugins: {
    // 2026-04-27: bonjour 在 openclaw 2026.4.24 base 里 CIAO PROBING CANCELLED
    // 抛 unhandled rejection,把 gateway 30s 一循环 kill 掉。Docker 容器内
    // mDNS 本来就用不上,直接禁用规避。
    deny: ["bonjour"],
    entries: {
      acpx: { enabled: true },
    },
  },

  // models.providers intentionally omitted — openclaw auto-discovers
  // anthropic (via ANTHROPIC_API_KEY + ANTHROPIC_BASE_URL) and openrouter
  // (via OPENROUTER_API_KEY) from env vars injected by start-user.sh.
  // Explicit provider declarations caused "invalid streaming response"
  // errors with Wangsu LiteLLM proxy (carher-199 incident 2026-04-25).
}
