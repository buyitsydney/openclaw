// config/env/docker.json5 — Docker carher-{N} environment overlay
//
// $include's base.json5. Overrides/adds fields that differ for every docker
// container but are identical across docker users.
//
// Do NOT put per-user identity here (feishu appId, primary model, etc.) —
// those live in users/{N}.json5.
//
// All secrets are ${VAR_NAME}; real values come from docker/server.env
// (shared) or docker/users/{N}.env (per-user, injected via --env-file).

{
  "$include": "./base.json5",

  // 2026-05-01: Fleet-wide bump. 默认 18k 对装 45+ skill 的容器(carher-13 等)
  // 会触发 compact 模式砍掉所有 skill description,skill 触发判断基本瞎。32k 覆盖现况。
  skills: {
    limits: {
      maxSkillsPromptChars: 32000,
    },
  },

  browser: {
    headless: true,
    noSandbox: true,
  },

  channels: {
    feishu: {
      // Docker users default to open group policy; admin host defaults to
      // allowlist in users/admin.json5.
      groupPolicy: "open",
      reasoning: { defaultLevel: "off" },
      // 2026-05-09 old-Her UX alignment:
      // - group/direct replies use a single CardKit streaming card instead of
      //   flooding the group with block/final post fragments.
      // - footer is visible again as a compact one-line status bar.
      //   R-10 enriches the upstream footer metrics with compaction count and
      //   group mode, then renders only high-density fields.
      streaming: true,
      replyMode: { default: "streaming", group: "streaming", direct: "streaming" },
      footer: {
        status: false,
        elapsed: true,
        model: true,
        tokens: false,
        cache: false,
        context: true,
      },
      // Deep-merged with per-user channels.feishu (appId/secret/etc) via $include.
    },
  },

  commands: {
    restart: false,
  },

  gateway: {
    bind: "lan",
    auth: {
      mode: "token",
      token: "${CARHER_GATEWAY_TOKEN}",
    },
    controlUi: {
      allowInsecureAuth: true,
      dangerouslyAllowHostHeaderOriginFallback: true,
      dangerouslyDisableDeviceAuth: true,
    },
  },

  agents: {
    defaults: {
      // 2026-05-07 M2.1 · OpenClaw 2026.5.3 引入严格 model idle timeout;
      // default=120s 对 Wangsu LiteLLM 太紧, 特别是 stop-hook-pipeline 触发
      // same-turn continuation 时(两次 LLM call 叠加)。600s 总 turn 上限。
      // 经过 carher-200 灰度验证 (dev 分支 56359248d42): 无 timeout, stop-hook 正常。
      timeoutSeconds: 600,
      // All docker users default to Wangsu opus-4-7 as primary. Override
      // per-user in config/u${N}.json5 if needed (e.g., users with CSV
      // provider=openrouter may want openrouter/anthropic/claude-opus-4.7).
      model: { primary: "anthropic/anthropic.claude-opus-4-7" },
      models: {
        // Wangsu (anthropic-messages API) aliases.
        // Keys MUST match the model ids declared in
        // models.providers.anthropic.models below — Wangsu requires the
        // "anthropic." prefix; non-prefixed ids are rejected with 401
        // "key not allowed to access model". These cover the default
        // docker user (CSV provider=anthropic, which is 4/6 of the fleet).
        // Users with CSV provider=openrouter override these in their
        // config/u${N}.json5 to point "opus"/"sonnet" at openrouter/* ids.
        "anthropic/anthropic.claude-opus-4-7": { alias: "opus" },
        "anthropic/anthropic.claude-opus-4-6": { alias: "opus46" },
        "anthropic/anthropic.claude-sonnet-4-6": { alias: "sonnet" },
        "anthropic/anthropic.claude-haiku-4-5": { alias: "haiku" },

        // OpenRouter aliases (match the pre-rebuild docker aliases so users
        // don't have to relearn; host uses its own set in users/admin.json5).
        "openrouter/anthropic/claude-opus-4.7": {
          alias: "or-opus",
          params: { provider: { allow_fallbacks: true, ignore: ["Google"] } },
        },
        "openrouter/anthropic/claude-opus-4.6": {
          alias: "or-opus46",
          params: { provider: { allow_fallbacks: true, ignore: ["Google"] } },
        },
        "openrouter/anthropic/claude-sonnet-4.6": {
          alias: "or-sonnet",
          params: { provider: { allow_fallbacks: true, ignore: ["Google"] } },
        },
        "openrouter/google/gemini-3.1-pro-preview": { alias: "gemini" },
        "openrouter/minimax/minimax-m2.7": { alias: "minimax" },
        "openrouter/openai/gpt-5.5": { alias: "gpt" },
        "openrouter/openai/gpt-5.4": { alias: "gpt54" },
        "openrouter/openai/gpt-5.3-codex": { alias: "codex" },
        "openrouter/deepseek/deepseek-v4-pro": { alias: "ds" },
        "openrouter/deepseek/deepseek-v4-flash": { alias: "ds-flash" },
      },
      // 2026-05-09 R-8 fleet promote · 13 灰度 (~/openclaw-baselines/13-memory-search-20260509/)
      // 验证 60d half-life 在 dev HEAD 94baa426a4a + image p13-knownbots 上稳定:
      //  - >21d 老 session noise 命中 16.9% → 5.0%
      //  - >28d 0.4% (基本清零)
      //  - 36 个 session-only query 全部保持 8/8 hits 不丢
      //  - top-1 与 baseline 一致率 51% (温和)
      // 必须配合 R-8 runtime patch (apply-session-decay.sh) 才能对 sessions/* 生效。
      memorySearch: {
        query: {
          hybrid: {
            temporalDecay: { enabled: true, halfLifeDays: 60 },
          },
        },
      },
    },
  },

  acp: {
    enabled: true,
    backend: "acpx",
    defaultAgent: "claude",
    allowedAgents: ["claude"],
    maxConcurrentSessions: 2,
    dispatch: { enabled: true },
    runtime: { ttlMinutes: 120 },
  },

  plugins: {
    // 2026-04-27: bonjour 在 openclaw 2026.4.24 base 里 CIAO PROBING CANCELLED
    // 抛 unhandled rejection,把 gateway 30s 一循环 kill 掉。Docker 容器内
    // mDNS 本来就用不上,直接禁用规避。
    // bonjour: CIAO PROBING CANCELLED → unhandled rejection crash loop (2026.4.24)
    // feishu: bundled upstream channel conflicts with openclaw-lark (both register "feishu")
    deny: ["bonjour"],
    // Three-component architecture plugin paths:
    //   - feishu-her / a2a-gateway / shadow-daemon: baked in image at /app/docker/plugins/
    //   - openclaw-lark: runtime npm install to /data/.openclaw/extensions/
    // Absolute paths make loader CWD-independent (gateway CWD=/app, tools CWD=/data/...).
    load: {
      paths: [
        "/data/.openclaw/extensions/node_modules/@larksuite/openclaw-lark",
        "/app/docker/plugins/feishu-her",
        "/app/docker/plugins/a2a-gateway",
        "/app/docker/plugins/shadow-daemon",
        "/app/docker/plugins/her-antitalker-poc",
      ],
    },
    entries: {
      // All runtime-loaded plugins must be explicitly enabled here because
      // $include config blocks auto-enable persistence (gateway cannot write
      // back to $include-owned config files).
      "openclaw-lark": { enabled: true },
      "feishu-her": { enabled: true },
      "shadow-daemon": { enabled: true },
      "her-antitalker-poc": { enabled: true },
      acpx: { enabled: true },
    },
  },

  // 2026-05-07 M2.1 · Fleet-wide idle timeout fix.
  //
  // 问题:OpenClaw 2026.5.3 引入 LLM idle timeout,default=120s。
  // resolveLlmIdleTimeoutMs (selection-BgogoK8g.js:6075) 里唯一能绕过 120s 硬顶的
  // 分支是 modelRequestTimeoutMs,它由 models.providers.<id>.timeoutSeconds 产出。
  // agents.defaults.timeoutSeconds 被 DEFAULT_LLM_IDLE_TIMEOUT_MS=120s clamp。
  //
  // Schema 要求 required:["baseUrl","models"]。baseUrl 必须和 env 值一致,
  // 否则 Wangsu 会返回 "invalid streaming response" (199 事故 2026-04-25)。
  // 用 ${VAR} 显式对齐 env。
  //
  // A/B 实证 (carher-200 anthropic + carher-199 anthropic & openrouter 双重验证,
  // dist 临时强制 default=500ms 加速复现 prompt 阶段 idle timeout):
  //   无此 block → 100% 触发 "The model did not produce a response before the
  //                           model idle timeout..."
  //   有此 block → modelRequestTimeoutMs=600s 覆盖, 0 条 timeout。
  //
  // 覆盖 anthropic + openrouter 两个 provider(fleet 主要两个来源)。
  models: {
    providers: {
      anthropic: {
        apiKey: "${ANTHROPIC_AUTH_TOKEN}",
        baseUrl: "${ANTHROPIC_BASE_URL}",
        timeoutSeconds: 600,
        models: [
          {
            id: "anthropic.claude-opus-4-7",
            name: "Claude Opus 4.7 (Wangsu)",
            api: "anthropic-messages",
            reasoning: true,
            input: ["text", "image"],
            contextWindow: 1000000,
            maxTokens: 128000,
            cost: { input: 5, output: 25, cacheRead: 0.5, cacheWrite: 6.25 },
          },
          {
            id: "anthropic.claude-opus-4-6",
            name: "Claude Opus 4.6 (Wangsu)",
            api: "anthropic-messages",
            reasoning: true,
            input: ["text", "image"],
            contextWindow: 1000000,
            maxTokens: 128000,
            cost: { input: 5, output: 25, cacheRead: 0.5, cacheWrite: 6.25 },
          },
          {
            id: "anthropic.claude-sonnet-4-6",
            name: "Claude Sonnet 4.6 (Wangsu)",
            api: "anthropic-messages",
            reasoning: true,
            input: ["text", "image"],
            contextWindow: 400000,
            maxTokens: 64000,
            cost: { input: 3, output: 15, cacheRead: 0.3, cacheWrite: 3.75 },
          },
          {
            id: "anthropic.claude-haiku-4-5",
            name: "Claude Haiku 4.5 (Wangsu)",
            api: "anthropic-messages",
            reasoning: false,
            input: ["text", "image"],
            contextWindow: 200000,
            maxTokens: 8192,
            cost: { input: 1, output: 5, cacheRead: 0.1, cacheWrite: 1.25 },
          },
        ],
      },
      openrouter: {
        apiKey: "${OPENROUTER_API_KEY}",
        baseUrl: "https://openrouter.ai/api/v1",
        timeoutSeconds: 600,
        models: [
          { id: "anthropic/claude-opus-4.7", name: "Claude Opus 4.7", api: "openai-completions", reasoning: true, input: ["text", "image"], contextWindow: 1000000, maxTokens: 128000, cost: { input: 5, output: 25, cacheRead: 0.5, cacheWrite: 6.25 } },
          { id: "anthropic/claude-opus-4.6", name: "Claude Opus 4.6", api: "openai-completions", reasoning: true, input: ["text", "image"], contextWindow: 100000, maxTokens: 128000, cost: { input: 5, output: 25, cacheRead: 0.5, cacheWrite: 6.25 } },
          { id: "anthropic/claude-sonnet-4.6", name: "Claude Sonnet 4.6", api: "openai-completions", reasoning: true, input: ["text", "image"], contextWindow: 100000, maxTokens: 64000, cost: { input: 3, output: 15, cacheRead: 0.3, cacheWrite: 3.75 } },
          { id: "openai/gpt-5.5", name: "GPT-5.5", api: "openai-completions", reasoning: true, input: ["text", "image"], contextWindow: 200000, maxTokens: 128000, cost: { input: 2.5, output: 15, cacheRead: 0.25 } },
          { id: "openai/gpt-5.4", name: "GPT-5.4", api: "openai-completions", reasoning: true, input: ["text", "image"], contextWindow: 200000, maxTokens: 128000, cost: { input: 2.5, output: 15, cacheRead: 0.25 } },
          { id: "openai/gpt-5.3-codex", name: "GPT-5.3 Codex", api: "openai-completions", reasoning: true, input: ["text", "image"], contextWindow: 200000, maxTokens: 128000, cost: { input: 1.75, output: 14, cacheRead: 0.175 } },
          { id: "google/gemini-3.1-pro-preview", name: "Gemini 3.1 Pro", api: "openai-completions", reasoning: true, input: ["text", "image"], contextWindow: 200000, maxTokens: 65536, cost: { input: 2, output: 12, cacheRead: 0.2, cacheWrite: 0.375 } },
          { id: "minimax/minimax-m2.7", name: "MiniMax M2.7", api: "openai-completions", reasoning: false, input: ["text"], contextWindow: 200000, maxTokens: 16384, cost: { input: 0.8, output: 4 } },
          { id: "z-ai/glm-5", name: "GLM-5", api: "openai-completions", reasoning: true, input: ["text"], contextWindow: 200000, maxTokens: 131072, cost: { input: 0.95, output: 2.55 } },
          { id: "deepseek/deepseek-v4-pro", name: "DeepSeek V4 Pro", api: "openai-completions", reasoning: true, input: ["text"], contextWindow: 200000, maxTokens: 65536, cost: { input: 0.27, output: 1.1 } },
          { id: "deepseek/deepseek-v4-flash", name: "DeepSeek V4 Flash", api: "openai-completions", reasoning: false, input: ["text"], contextWindow: 200000, maxTokens: 65536, cost: { input: 0.14, output: 0.28 } },
        ],
      },
    },
  },
}
