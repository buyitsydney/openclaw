// config/u200.json5 — S1 carher-200 identity (研究3)
//
// $include's docker.json5 → base.json5. Mounted into the container at
// /data/.openclaw/openclaw.json.

{
  "$include": "./docker.json5",

  // 2026-04-27: 0424 boot check needs gateway.mode at root (no $include expansion).
  gateway: {
    mode: "local",
  },


  // A2A hub mode: 13/198/199/200 are permanent hubs (god-mode peers).
  plugins: {
    entries: {
      "her-antitalker-poc": { enabled: true, hooks: { allowConversationAccess: true } },
      "hook-probe": { enabled: true, hooks: { allowConversationAccess: true } },
      "a2a-gateway": {
        config: {
          outbound: { enabled: true },
        },
      },
    },
  },

  // 2026-05-03 v7.3 · antitalker Bug 4/5 fix
  // heartbeat.target='last' tells OpenClaw to use session.lastChannel (feishu)
  // instead of 'none' → canRelayToUser flips true → exec completion prompt
  // becomes 'The command completion details are:' instead of 'reply HEARTBEAT_OK only'.
  // Boundary: A2A/cron isolated sessions still silence (no feishu lastChannel).
  // 2026-05-07 · M2.1 stop-hook-pipeline grayscale (carher-200 only):
  // agents.defaults.timeoutSeconds = 600 caps the outer per-turn budget.
  agents: {
    defaults: {
      timeoutSeconds: 600,
      heartbeat: {
        target: "last",
      },
    },
  },

  // 2026-05-07 · M2.1 · models.providers.anthropic.timeoutSeconds = 600
  // This is the ONLY lever that extends the LLM idle timeout past the hard
  // 120s default (resolveLlmIdleTimeoutMs clamps agents.defaults.timeoutSeconds
  // by min(value, 120s) but respects modelRequestTimeoutMs unclamped).
  //
  // When stop-hook-pipeline fires a same-turn continuation, the 2nd LLM call
  // on top of a slow Wangsu 1st call can exceed 120s → user sees
  // "The model did not produce a response before the model idle timeout".
  //
  // Shape copied from config/admin.json5 (the existing working template).
  // baseUrl intentionally omitted — auto-discovered from ANTHROPIC_BASE_URL env.
  // 199 previously died from an explicit baseUrl + env conflict, so we keep
  // the env-driven discovery and only add timeoutSeconds.
  //
  // models list is the minimum that covers the primary alias resolution
  // (anthropic/anthropic.claude-opus-4-7) used by docker.json5.
  models: {
    providers: {
      anthropic: {
        timeoutSeconds: 600,
        apiKey: "${ANTHROPIC_AUTH_TOKEN}",
        models: [
          {
            id: "anthropic.claude-opus-4-7",
            name: "Claude Opus 4.7 (Wangsu)",
            api: "anthropic-messages",
            reasoning: true,
            input: ["text", "image"],
            contextWindow: 1000000,
            maxTokens: 128000,
            cost: { input: 5, output: 25, cacheRead: 0.5, cacheWrite: 6.25 },
          },
          {
            id: "anthropic.claude-opus-4-6",
            name: "Claude Opus 4.6 (Wangsu)",
            api: "anthropic-messages",
            reasoning: true,
            input: ["text", "image"],
            contextWindow: 1000000,
            maxTokens: 128000,
            cost: { input: 5, output: 25, cacheRead: 0.5, cacheWrite: 6.25 },
          },
          {
            id: "anthropic.claude-sonnet-4-6",
            name: "Claude Sonnet 4.6 (Wangsu)",
            api: "anthropic-messages",
            reasoning: true,
            input: ["text", "image"],
            contextWindow: 400000,
            maxTokens: 64000,
            cost: { input: 3, output: 15, cacheRead: 0.3, cacheWrite: 3.75 },
          },
          {
            id: "anthropic.claude-haiku-4-5",
            name: "Claude Haiku 4.5 (Wangsu)",
            api: "anthropic-messages",
            reasoning: false,
            input: ["text", "image"],
            contextWindow: 200000,
            maxTokens: 8192,
            cost: { input: 1, output: 5, cacheRead: 0.1, cacheWrite: 1.25 },
          },
        ],
      },
    },
  },

  channels: {
    feishu: {
      name: "研究3",
      appId: "cli_a96f044b4ef95cc0",
      appSecret: "${FEISHU_APP_SECRET}",
      botOpenId: "ou_c2bc759110aa5bc80b2edea2ede864e9",
      oauthRedirectUri: "https://s1-u200-auth.carher.net/feishu/oauth/callback",
      dm: {
        allowFrom: ["ou_4a9a4f41779063d4ab0d63548f775fd5"],
      },
    },
  },
}
