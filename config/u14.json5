// config/u14.json5 — S3 carher-14 identity (刘国现 / 国现的her)
//
// $include's docker.json5 → base.json5. Mounted into the container at
// /data/.openclaw/openclaw.json by compose bind-mount.
//
// 结构跟 u200.json5 对齐 (A2A hub mode + heartbeat.target=last + plugin entries),
// 只换 4 个身份字段 (name/appId/botOpenId/owner open_id) + URL host。
// 国现 provider=openrouter,所以 agents.defaults.model.primary 覆盖到 OpenRouter。

{
  "$include": "./docker.json5",

  // 2026-04-27: 0424 boot check needs gateway.mode at root (no $include expansion).
  gateway: {
    mode: "local",
  },


  // A2A hub mode: 13/198/199/200 are permanent hubs (god-mode peers).
  // 14 加入 hub set (allow outbound) — 国现可以主动调度其他 peer。
  plugins: {
    entries: {
      "her-antitalker-poc": { enabled: true, hooks: { allowConversationAccess: true } },
      "hook-probe": { enabled: true, hooks: { allowConversationAccess: true } },
      "a2a-gateway": {
        config: {
          outbound: { enabled: true },
        },
      },
    },
  },

  // 2026-05-03 v7.3 · antitalker Bug 4/5 fix
  // heartbeat.target='last' tells OpenClaw to use session.lastChannel (feishu)
  // instead of 'none' → canRelayToUser flips true → exec completion prompt
  // becomes 'The command completion details are:' instead of 'reply HEARTBEAT_OK only'.
  //
  // 国现 model override: 用 OpenRouter 路径,不走 Wangsu LiteLLM (跟 docker.json5
  // 默认 anthropic/anthropic.claude-opus-4-7 不同)。
  agents: {
    defaults: {
      model: { primary: "openrouter/anthropic/claude-opus-4.7" },
      heartbeat: {
        target: "last",
      },
    },
  },

  channels: {
    feishu: {
      name: "国现的her",
      appId: "cli_a91569fab9b81bc6",
      appSecret: "${FEISHU_APP_SECRET}",
      botOpenId: "ou_aedf3bafc1277fc330062ec7efae1ca4",
      oauthRedirectUri: "https://s3-u14-auth.carher.net/feishu/oauth/callback",
      dm: {
        allowFrom: ["ou_fbaf6eec244d1c4a4541a477678dab17"],
      },
    },
  },
}
