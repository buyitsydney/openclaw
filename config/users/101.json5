// config/users/101.json5 — Docker carher-101 identity (Layer 3)
//
// $include's env/docker.json5 → base.json5. Final file mounted into the
// container at /data/.openclaw/openclaw.json.
//
// Only per-user identity fields. Real appSecret comes from
// docker/users/101.env via --env-file on docker run.

{
  "$include": "../env/docker.json5",

  agents: {
    defaults: {
      model: { primary: "openrouter/minimax/minimax-m2.7" },
    },
  },

  channels: {
    feishu: {
      name: "tester的her",
      appId: "cli_a92c99d102b8dbca",
      appSecret: "${FEISHU_APP_SECRET}",
      botOpenId: "ou_1a9c02079fef1f5f0f4daaaaffd2326c",
      oauthRedirectUri: "https://u101-auth.carher.net/feishu/oauth/callback",
      dm: {
        allowFrom: ["ou_a7afacbb81237891a181832ac7a76294"],
      },
    },
  },
}
