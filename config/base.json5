// config/base.json5 — all-agent shared behavior
//
// Layer 1/3 of the config tree. $include'd (transitively) by every agent.
// Do not add env-specific or identity-specific fields here.
//
// Array-field rule: arrays in this file MUST NOT be redeclared in any
// overlay (deep-merge concatenates, not replaces). The existing concat
// bugs this rebuild fixes:
//   - memorySearch.sources was ["memory","sessions"] × 3
//   - plugins.load.paths was ["/app/docker/…","docker/…"]
//   - tools.media.audio.models was [{groq}] × 3
// Each array below appears here once and only once.

{
  agents: {
    defaults: {
      userTimezone: "Asia/Shanghai",
      maxConcurrent: 16,
      subagents: { maxConcurrent: 64 },
      compaction: { mode: "safeguard", reserveTokens: 200000 },
      memorySearch: {
        provider: "openai",
        model: "BAAI/bge-m3",
        // Array is declared here once. No overlay may redeclare this key.
        sources: ["memory", "sessions"],
        experimental: { sessionMemory: true },
        remote: {
          baseUrl: "https://openrouter.ai/api/v1/",
          apiKey: "${OPENROUTER_API_KEY}",
        },
        query: {
          minScore: 0.25,
          maxResults: 8,
          hybrid: {
            vectorWeight: 0.7,
            textWeight: 0.3,
            mmr: { enabled: true, lambda: 0.4 },
          },
        },
      },
      models: {
        "openrouter/z-ai/glm-5": { alias: "glm" },
      },
    },
  },

  browser: {
    enabled: true,
    defaultProfile: "openclaw",
    cdpPortRangeStart: 18900,
  },

  channels: {
    feishu: {
      enabled: true,
      groupPolicy: "open",
      dmPolicy: "open",
    },
  },

  commands: {
    native: "auto",
    nativeSkills: "auto",
  },

  gateway: {
    mode: "local",
    port: 18789,
  },

  messages: {
    ackReactionScope: "group-mentions",
    // 0503 defaults group chat to "message_tool_only" (agent must use message
    // tool explicitly). Our feishu-her plugin uses the deliver callback
    // (automatic delivery), so we need "automatic" to keep group replies working.
    groupChat: { visibleReplies: "automatic" },
    tts: {
      auto: "inbound",
      provider: "edge",
      providers: { edge: { voice: "zh-CN-XiaoxiaoNeural" } },
    },
  },

  // models.providers intentionally omitted — openclaw auto-discovers
  // anthropic + openrouter from env vars (ANTHROPIC_API_KEY/BASE_URL,
  // OPENROUTER_API_KEY). baseUrl for Wangsu proxy is set via
  // ANTHROPIC_BASE_URL env var in server.env.

  plugins: {
    // A+B v2 (2026-04): bundled feishu plugin removed; no deny needed.
    //
    // plugins.load.paths is env-specific (absolute path of plugin dir on disk
    // differs between docker / native / mac app), so it lives in the env
    // overlay — docker.json5 for containers, future host overlay for native
    // her. Keeping relative paths here was a config bug: openclaw 0424
    // resolves them via `path.resolve(trimmed)` which uses process.cwd(), so
    // the gateway at CWD=/app sees `/app/docker/plugins/*` OK but a her-side
    // `openclaw status` tool call at CWD=/data/.openclaw/workspace sees a
    // non-existent `/data/.openclaw/workspace/docker/plugins/*` and reports
    // "Config invalid" even though the running gateway is healthy.
    //
    // Array-field rule (see header): since paths is NOT declared here, any
    // overlay may declare it once without the deep-merge concat bug.
    entries: {
      // Disable bundled feishu plugin — openclaw-lark (runtime npm) replaces it.
      // Using entries.feishu.enabled=false instead of deny because 0503 deny
      // validation requires the plugin to be loadable.
      feishu: { enabled: false },
      "feishu-her": { enabled: true },
      "a2a-gateway": {
        enabled: true,
        config: {
          routing: { defaultAgentId: "main" },
          limits: { maxConcurrentTasks: 16 },
          // Overridden per-user in users/admin.json5 (hub) and left default
          // (spoke) in users/{101,102}.json5.
          outbound: { enabled: true },
        },
      },
      "shadow-daemon": {
        enabled: true,
        config: {
          shadowDir: "memory/_shadow",
        },
      },
      "active-memory": { enabled: false },
      "memory-core": {
        config: {
          dreaming: {
            enabled: false,
            timezone: "Asia/Shanghai",
            frequency: "0 3 * * *",
          },
        },
      },
      "memory-wiki": {
        enabled: true,
        config: {
          vaultMode: "bridge",
          bridge: {
            enabled: true,
            readMemoryArtifacts: true,
            indexDreamReports: true,
            indexDailyNotes: true,
            indexMemoryRoot: true,
            followMemoryEvents: true,
          },
          ingest: { autoCompile: true, allowUrlIngest: true },
          search: { backend: "shared", corpus: "all" },
        },
      },
    },
  },

  tools: {
    // sessions.visibility="all" + agentToAgent.enabled=true are needed for
    // cross-agent sessions_history (ACP). Both fields apply to every agent,
    // so they live in base.json5 (promoted from dev commits
    // 16304bb71a + a964bfd9ce). Host admin layer additionally restricts
    // the A2A allowlist to ["main"] in users/admin.json5.
    sessions: { visibility: "all" },
    agentToAgent: { enabled: true },
    web: { search: { provider: "perplexity" } },
    // Array declared here once; overlays MUST NOT redeclare this key.
    media: { audio: { models: [{ provider: "groq" }] } },
  },
}
